{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catálogo de BiciRuta S.L.",
  "description": "Mismas reglas que catalogo.xsd, aplicadas a catalogo.json",
  "type": "object",
  "required": ["tienda", "actualizado", "productos"],
  "properties": {
    "tienda":      { "type": "string" },
    "actualizado": { "type": "string", "format": "date" },
    "productos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/producto" }
    }
  },
  "definitions": {
    "producto": {
      "type": "object",
      "required": ["ref", "categoria", "nombre", "precio", "stock"],
      "properties": {
        "ref":         { "type": "string", "pattern": "^BR-[0-9]{4}$" },
        "categoria":   { "enum": ["bicicleta", "accesorio", "recambio"] },
        "proveedor":   { "type": "string" },
        "nombre":      { "type": "string" },
        "precio":      { "type": "number", "exclusiveMinimum": 0 },
        "moneda":      { "enum": ["EUR", "USD"], "default": "EUR" },
        "stock":       { "type": "integer", "minimum": 0 },
        "descripcion": { "type": "string" },
        "caracteristicas": {
          "type": "object",
          "properties": {
            "talla":  { "enum": ["S", "M", "L", "XL"] },
            "pesoKg": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
