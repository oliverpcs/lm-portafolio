<?xml version="1.0" encoding="UTF-8"?>
<!-- inventario.xsd · Esquema del inventario de equipos de red del aula -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Identificador del equipo: EQ- y dos dígitos -->
  <xs:simpleType name="tipoId">
    <xs:restriction base="xs:string">
      <xs:pattern value="EQ-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Dirección IPv4: cuatro números de 0 a 255 separados por puntos -->
  <xs:simpleType name="tipoIP">
    <xs:restriction base="xs:string">
      <xs:pattern value="((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Dirección MAC: seis pares hexadecimales en mayúsculas separados por : -->
  <xs:simpleType name="tipoMAC">
    <xs:restriction base="xs:string">
      <xs:pattern value="([0-9A-F]{2}:){5}[0-9A-F]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Red en notación CIDR, por ejemplo 192.168.10.0/24 -->
  <xs:simpleType name="tipoRed">
    <xs:restriction base="xs:string">
      <xs:pattern value="([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoEquipo">
    <xs:restriction base="xs:string">
      <xs:enumeration value="router"/>
      <xs:enumeration value="switch"/>
      <xs:enumeration value="punto-acceso"/>
      <xs:enumeration value="servidor"/>
      <xs:enumeration value="impresora"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoEstado">
    <xs:restriction base="xs:string">
      <xs:enumeration value="operativo"/>
      <xs:enumeration value="averiado"/>
      <xs:enumeration value="baja"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Ubicación: texto + atributo rack opcional -->
  <xs:complexType name="tipoUbicacion">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="rack" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="tipoEquipoRed">
    <xs:sequence>
      <xs:element name="nombre"      type="xs:string"/>
      <xs:element name="marca"       type="xs:string"/>
      <xs:element name="modelo"      type="xs:string"/>
      <xs:element name="ip"          type="tipoIP"/>
      <xs:element name="mac"         type="tipoMAC"/>
      <xs:element name="ubicacion"   type="tipoUbicacion"/>
      <xs:element name="fechaCompra" type="xs:date"/>
      <xs:element name="estado"      type="tipoEstado"/>
      <!-- Solo para switches: número de puertos (1 a 52) -->
      <xs:element name="puertos" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:positiveInteger">
            <xs:maxInclusive value="52"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id"   type="tipoId"     use="required"/>
    <xs:attribute name="tipo" type="tipoEquipo" use="required"/>
  </xs:complexType>

  <xs:element name="inventario">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="equipo" type="tipoEquipoRed" minOccurs="5" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="aula"        type="xs:string" use="required"/>
      <xs:attribute name="red"         type="tipoRed"   use="required"/>
      <xs:attribute name="actualizado" type="xs:date"   use="required"/>
    </xs:complexType>

    <!-- En una red no puede haber dos equipos con el mismo id, IP o MAC -->
    <xs:unique name="idUnico">
      <xs:selector xpath="equipo"/><xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="ipUnica">
      <xs:selector xpath="equipo"/><xs:field xpath="ip"/>
    </xs:unique>
    <xs:unique name="macUnica">
      <xs:selector xpath="equipo"/><xs:field xpath="mac"/>
    </xs:unique>
  </xs:element>
</xs:schema>
